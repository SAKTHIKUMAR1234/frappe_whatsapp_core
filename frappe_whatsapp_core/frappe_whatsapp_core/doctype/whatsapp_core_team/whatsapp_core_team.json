{
	"doctype": "DocType",
	"name": "WhatsApp Core Team",
	"module": "Frappe WhatsApp Core",
	"autoname": "field:team_name",
	"naming_rule": "By fieldname",
	"engine": "InnoDB",
	"field_order": [
		"team_name",
		"icon",
		"description",
		"managed_source",
		"enabled",
		"members",
		"contacts"
	],
	"fields": [
		{
			"fieldname": "team_name",
			"fieldtype": "Data",
			"label": "Team Name",
			"reqd": 1,
			"unique": 1,
			"in_list_view": 1
		},
		{
			"default": "users-round",
			"fieldname": "icon",
			"fieldtype": "Icon",
			"in_list_view": 1,
			"label": "Icon"
		},
		{
			"fieldname": "description",
			"fieldtype": "Small Text",
			"label": "Description"
		},
		{
			"fieldname": "managed_source",
			"fieldtype": "Data",
			"hidden": 1,
			"label": "Managed Source",
			"read_only": 1
		},
		{
			"fieldname": "enabled",
			"fieldtype": "Check",
			"label": "Enabled",
			"default": "1",
			"in_list_view": 1
		},
		{
			"fieldname": "members",
			"fieldtype": "Table",
			"label": "Members",
			"options": "WhatsApp Core Team Member"
		},
		{
			"fieldname": "contacts",
			"fieldtype": "Table",
			"label": "Contacts",
			"options": "WhatsApp Core Team Contact"
		}
	],
	"permissions": [
		{
			"role": "System Manager",
			"read": 1,
			"write": 1,
			"create": 1,
			"delete": 1,
			"export": 1
		},
  {
    "role": "WhatsApp Manager",
			"read": 1,
			"write": 1,
			"create": 1,
			"delete": 1,
    "export": 1
  },
  {
    "role": "WhatsApp User",
    "read": 1
  }
	],
	"sort_field": "team_name",
	"sort_order": "ASC",
	"track_changes": 1
}
