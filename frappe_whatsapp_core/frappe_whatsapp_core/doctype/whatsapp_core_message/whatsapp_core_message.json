{
	"doctype": "DocType",
	"name": "WhatsApp Core Message",
	"module": "Frappe WhatsApp Core",
	"title_field": "provider_message_id",
	"show_title_field_in_link": 1,
	"autoname": "hash",
	"naming_rule": "Random",
	"engine": "InnoDB",
	"field_order": [
		"message_key",
		"idempotency_key",
		"conversation",
		"relay_event",
		"channel",
		"provider_message_id",
		"provider_template_id",
		"direction",
