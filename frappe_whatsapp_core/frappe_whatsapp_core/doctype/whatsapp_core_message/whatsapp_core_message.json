			"label": "Delivery Status",
			"options": "Received\nQueued\nSent\nDelivered\nRead\nFailed\nDeleted",
			"reqd": 1
		},
		{
			"fieldname": "failure",
			"fieldtype": "JSON",
			"label": "Failure"
