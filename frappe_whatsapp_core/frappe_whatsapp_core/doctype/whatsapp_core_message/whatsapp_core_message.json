			"read": 1,
			"write": 1,
			"create": 1,
			"export": 1
		},
		{
			"role": "WhatsApp Manager",
			"read": 1,
			"export": 1
		},
		{
			"role": "WhatsApp User",
			"read": 1,
			"export": 1
		}
