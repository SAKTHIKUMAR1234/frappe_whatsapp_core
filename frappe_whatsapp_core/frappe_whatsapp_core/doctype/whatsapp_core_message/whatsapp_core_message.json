			"fieldname": "provider_message_id",
			"fieldtype": "Data",
			"label": "Provider Message ID",
			"reqd": 1,
			"unique": 1
		},
		{
			"fieldname": "provider_template_id",
			"fieldtype": "Data",
			"label": "Provider Template ID",
			"read_only": 1
		},
		{
			"fieldname": "direction",
