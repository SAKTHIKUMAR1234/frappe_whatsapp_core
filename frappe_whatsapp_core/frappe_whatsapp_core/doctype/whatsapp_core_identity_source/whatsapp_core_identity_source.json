{
  "doctype": "DocType",
  "name": "WhatsApp Core Identity Source",
  "module": "Frappe WhatsApp Core",
  "autoname": "field:source_key",
  "naming_rule": "By fieldname",
  "engine": "InnoDB",
  "field_order": [
    "source_key",
    "display_name",
    "source_doctype",
    "enabled",
    "auto_resolve",
    "priority",
    "mapping_section",
    "phone_field",
    "display_name_field",
    "entity_type_field",
    "filters"
  ],
  "fields": [
    {
      "fieldname": "source_key",
      "fieldtype": "Data",
      "label": "Source Key",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "display_name",
      "fieldtype": "Data",
      "label": "Display Name",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "source_doctype",
      "fieldtype": "Link",
      "label": "Source DocType",
      "options": "DocType",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "enabled",
      "fieldtype": "Check",
      "label": "Enabled",
      "default": "1",
      "in_list_view": 1
    },
    {
      "fieldname": "auto_resolve",
      "fieldtype": "Check",
      "label": "Resolve on Inbound Message",
      "default": "1"
    },
    {
      "fieldname": "priority",
      "fieldtype": "Int",
      "label": "Priority",
      "default": "100",
      "description": "Lower numbers are preferred when selecting the primary business link."
    },
    {
      "fieldname": "mapping_section",
      "fieldtype": "Section Break",
      "label": "Generic Field Mapping"
    },
    {
      "fieldname": "phone_field",
      "fieldtype": "Data",
      "label": "Phone Field",
      "reqd": 1,
      "description": "A fieldname or child-table path such as mobile_numbers.mobile_number."
    },
    {
      "fieldname": "display_name_field",
      "fieldtype": "Data",
      "label": "Display Name Field"
    },
    {
      "fieldname": "entity_type_field",
      "fieldtype": "Data",
      "label": "Entity Type Field"
    },
    {
      "fieldname": "filters",
      "fieldtype": "JSON",
      "label": "Filters",
      "description": "Optional source filters. Business apps may register a typed resolver for richer hierarchy logic."
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "export": 1
    },
    {
      "role": "WhatsApp Core Admin",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "export": 1
    },
    {
      "role": "WhatsApp Core Manager",
      "read": 1
    }
  ],
  "sort_field": "priority",
  "sort_order": "ASC"
}
