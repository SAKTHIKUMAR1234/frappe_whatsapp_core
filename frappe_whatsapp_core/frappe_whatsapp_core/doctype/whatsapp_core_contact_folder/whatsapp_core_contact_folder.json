{
 "doctype": "DocType",
 "name": "WhatsApp Core Contact Folder",
 "module": "Frappe WhatsApp Core",
 "autoname": "hash",
 "naming_rule": "Random",
 "engine": "InnoDB",
 "field_order": ["folder_key", "user", "folder_name", "folder_type", "color", "position"],
 "fields": [
  {"fieldname": "folder_key", "fieldtype": "Data", "label": "Folder Key", "reqd": 1, "unique": 1},
  {"fieldname": "user", "fieldtype": "Link", "label": "User", "options": "User", "reqd": 1, "in_list_view": 1},
  {"fieldname": "folder_name", "fieldtype": "Data", "label": "Folder Name", "reqd": 1, "in_list_view": 1},
  {"fieldname": "folder_type", "fieldtype": "Select", "label": "Folder Type", "options": "Important\nCustom", "default": "Custom", "reqd": 1},
  {"fieldname": "color", "fieldtype": "Color", "label": "Color", "default": "#22c55e"},
  {"fieldname": "position", "fieldtype": "Int", "label": "Position", "default": "0"}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
  {"role": "WhatsApp Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
  {"role": "WhatsApp User", "read": 1, "write": 1, "create": 1, "delete": 1}
 ],
 "sort_field": "position",
 "sort_order": "ASC"
}
