{
	"doctype": "DocType",
	"name": "WhatsApp Core Settings",
	"module": "Frappe WhatsApp Core",
	"issingle": 1,
	"engine": "InnoDB",
	"field_order": [
		"enabled",
		"outbound_enabled",
		"section_connection",
		"hub_url",
		"relay_url",
		"column_connection",
		"api_key",
		"api_secret",
		"request_timeout",
		"default_country_calling_code",
		"section_ai_summaries",
		"enable_ai_summaries",
		"summary_i2a_action",
		"summary_rollup_i2a_action",
		"summary_batch_size",
		"summary_max_media_mb",
		"section_accounts",
		"accounts"
	],
	"fields": [
		{
			"default": "0",
			"fieldname": "enabled",
			"fieldtype": "Check",
			"label": "WhatsApp Enabled"
		},
		{
			"default": "0",
			"fieldname": "outbound_enabled",
			"fieldtype": "Check",
			"label": "Outbound Enabled"
		},
		{
			"fieldname": "section_connection",
			"fieldtype": "Section Break",
			"label": "Integration Hub"
		},
		{
			"fieldname": "hub_url",
			"fieldtype": "Data",
			"label": "Hub URL",
			"description": "Control-plane URL of the central Frappe WhatsApp Integration site"
		},
		{
			"fieldname": "relay_url",
			"fieldtype": "Data",
			"label": "Go Relay URL",
			"description": "Required direct Go data-plane origin for webhooks, messages, media, and call operations; never the Hub Frappe API origin"
		},
		{
			"fieldname": "column_connection",
			"fieldtype": "Column Break"
		},
		{
			"fieldname": "api_key",
			"fieldtype": "Password",
			"label": "Hub API Key"
		},
		{
			"fieldname": "api_secret",
			"fieldtype": "Password",
			"label": "Hub API Secret"
		},
		{
			"default": "30",
			"fieldname": "request_timeout",
			"fieldtype": "Int",
			"label": "Request Timeout (seconds)"
		},
		{
			"default": "91",
			"description": "Used only when an operator or custom resolver supplies a local number without + or 00. International numbers keep their own calling code.",
			"fieldname": "default_country_calling_code",
			"fieldtype": "Data",
			"label": "Default Country Calling Code"
		},
		{
			"fieldname": "section_ai_summaries",
			"fieldtype": "Section Break",
			"label": "AI Message Understanding"
		},
		{
			"default": "0",
			"fieldname": "enable_ai_summaries",
			"fieldtype": "Check",
			"label": "Enable Incremental AI Summaries"
		},
		{
			"description": "Optional enabled I2A Action name. Used only when Frappe Tools is installed.",
			"fieldname": "summary_i2a_action",
			"fieldtype": "Data",
			"label": "Summary I2A Action"
		},
		{
			"description": "Optional Core-owned I2A Action name used for summary rollups when Frappe Tools is installed.",
			"fieldname": "summary_rollup_i2a_action",
			"fieldtype": "Data",
			"label": "Summary Rollup I2A Action"
		},
		{
			"default": "100",
			"fieldname": "summary_batch_size",
			"fieldtype": "Int",
			"label": "Messages Per Summary Pass"
		},
		{
			"default": "15",
			"fieldname": "summary_max_media_mb",
			"fieldtype": "Int",
			"label": "Maximum Media Size Per Message (MB)"
		},
		{
			"fieldname": "section_accounts",
			"fieldtype": "Section Break",
			"label": "Channel Routing"
		},
		{
			"fieldname": "accounts",
			"fieldtype": "Table",
			"label": "Hub Accounts",
			"options": "WhatsApp Core Hub Account"
		}
	],
	"permissions": [
		{
			"role": "System Manager",
			"read": 1,
			"write": 1,
			"create": 1
		},
		{
			"role": "WhatsApp Manager",
			"read": 1,
			"write": 1,
			"create": 1
		}
	]
}
