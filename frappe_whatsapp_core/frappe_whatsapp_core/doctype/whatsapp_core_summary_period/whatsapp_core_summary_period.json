{
 "doctype": "DocType",
 "name": "WhatsApp Core Summary Period",
 "module": "Frappe WhatsApp Core",
 "autoname": "field:summary_key",
 "naming_rule": "By fieldname",
 "engine": "InnoDB",
 "track_changes": 1,
 "field_order": [
  "summary_key", "identity", "period_type", "period_start", "period_end",
  "status", "summary", "categories", "action_items", "risks", "language",
  "confidence", "source_count", "message_count", "ai_action", "ai_model",
  "generated_at", "error"
 ],
 "fields": [
  {"fieldname":"summary_key","fieldtype":"Data","label":"Summary Key","reqd":1,"unique":1},
  {"fieldname":"identity","fieldtype":"Link","label":"Contact","options":"WhatsApp Core Identity","reqd":1,"in_list_view":1,"search_index":1},
  {"fieldname":"period_type","fieldtype":"Select","label":"Layer","options":"Daily\nWeekly\nMonthly\nYearly","reqd":1,"in_list_view":1,"search_index":1},
  {"fieldname":"period_start","fieldtype":"Date","label":"Period Start","reqd":1,"in_list_view":1,"search_index":1},
  {"fieldname":"period_end","fieldtype":"Date","label":"Period End","reqd":1},
  {"fieldname":"status","fieldtype":"Select","label":"Status","options":"Ready\nNeeds Review\nFailed","default":"Needs Review","reqd":1,"in_list_view":1},
  {"fieldname":"summary","fieldtype":"Long Text","label":"Summary"},
  {"fieldname":"categories","fieldtype":"JSON","label":"Categories"},
  {"fieldname":"action_items","fieldtype":"JSON","label":"Action Items"},
  {"fieldname":"risks","fieldtype":"JSON","label":"Risks"},
  {"fieldname":"language","fieldtype":"Data","label":"Language"},
  {"fieldname":"confidence","fieldtype":"Percent","label":"Confidence"},
  {"fieldname":"source_count","fieldtype":"Int","label":"Source Summaries","read_only":1},
  {"fieldname":"message_count","fieldtype":"Int","label":"Messages Represented","read_only":1},
  {"fieldname":"ai_action","fieldtype":"Link","label":"I2A Action","options":"I2A Action"},
  {"fieldname":"ai_model","fieldtype":"Data","label":"AI Model"},
  {"fieldname":"generated_at","fieldtype":"Datetime","label":"Generated At","in_list_view":1},
  {"fieldname":"error","fieldtype":"Small Text","label":"Error"}
 ],
 "permissions": [
  {"role":"System Manager","read":1,"export":1},
  {"role":"WhatsApp Manager","read":1,"export":1},
  {"role":"WhatsApp User","read":1}
 ],
 "sort_field": "period_start",
 "sort_order": "DESC"
}
