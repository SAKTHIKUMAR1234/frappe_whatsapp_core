{
 "doctype": "DocType",
 "name": "WhatsApp Core Message Insight",
 "module": "Frappe WhatsApp Core",
 "autoname": "hash",
 "naming_rule": "Random",
 "engine": "InnoDB",
 "track_changes": 1,
 "field_order": [
  "insight_key",
  "message",
  "conversation",
  "identity",
  "status",
  "category",
  "primary_intent",
  "confidence",
  "transcript",
  "media_summary",
  "message_summary",
  "intents",
  "action_items",
  "risks",
  "language",
  "ai_action",
  "ai_model",
  "analyzed_at",
  "error"
 ],
 "fields": [
  {
   "fieldname": "insight_key",
   "fieldtype": "Data",
   "label": "Insight Key",
   "reqd": 1,
   "unique": 1
  },
  {
   "fieldname": "message",
   "fieldtype": "Link",
   "label": "Message",
   "options": "WhatsApp Core Message",
   "reqd": 1,
   "unique": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "conversation",
   "fieldtype": "Link",
   "label": "Conversation",
   "options": "WhatsApp Core Conversation",
   "reqd": 1
  },
  {
   "fieldname": "identity",
   "fieldtype": "Link",
   "label": "Contact",
   "options": "WhatsApp Core Identity",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Ready\nNeeds Review\nFailed",
   "default": "Needs Review",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "category",
   "fieldtype": "Link",
   "label": "Category",
   "options": "WhatsApp Core Message Category",
   "in_list_view": 1
  },
  {
   "fieldname": "primary_intent",
   "fieldtype": "Data",
   "label": "Primary Intent"
  },
  {
   "fieldname": "confidence",
   "fieldtype": "Percent",
   "label": "Confidence"
  },
  {
   "fieldname": "transcript",
   "fieldtype": "Long Text",
   "label": "Voice Transcript"
  },
  {
   "fieldname": "media_summary",
   "fieldtype": "Long Text",
   "label": "Media Summary"
  },
  {
   "fieldname": "message_summary",
   "fieldtype": "Text",
   "label": "Message Summary"
  },
  {
   "fieldname": "intents",
   "fieldtype": "JSON",
   "label": "Intents"
  },
  {
   "fieldname": "action_items",
   "fieldtype": "JSON",
   "label": "Action Items"
  },
  {
   "fieldname": "risks",
   "fieldtype": "JSON",
   "label": "Risks"
  },
  {
   "fieldname": "language",
   "fieldtype": "Data",
   "label": "Language"
  },
  {
   "fieldname": "ai_action",
   "fieldtype": "Data",
   "label": "I2A Action"
  },
  {
   "fieldname": "ai_model",
   "fieldtype": "Data",
   "label": "AI Model"
  },
  {
   "fieldname": "analyzed_at",
   "fieldtype": "Datetime",
   "label": "Analyzed At"
  },
  {
   "fieldname": "error",
   "fieldtype": "Small Text",
   "label": "Error"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "export": 1
  },
  {
   "role": "WhatsApp Manager",
   "read": 1,
   "export": 1
  },
  {
   "role": "WhatsApp User",
   "read": 1
  }
 ],
 "sort_field": "analyzed_at",
 "sort_order": "DESC"
}
