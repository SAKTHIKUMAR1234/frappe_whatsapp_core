{
	"doctype": "DocType",
	"name": "WhatsApp Core Campaign",
	"module": "Frappe WhatsApp Core",
	"autoname": "field:campaign_key",
	"naming_rule": "By fieldname",
	"engine": "InnoDB",
	"field_order": [
		"campaign_key",
		"title",
		"description",
		"channel",
		"content_type",
		"template",
		"template_snapshot",
		"message_text",
		"audience_source",
		"status",
		"send_authorized",
		"authorized_by",
		"authorized_at",
		"prepared_at",
		"scheduled_for",
		"started_at",
		"completed_at",
		"recipient_count",
		"queued_count",
		"sent_count",
		"delivered_count",
		"read_count",
		"failed_count",
		"skipped_count"
	],
	"fields": [
		{
			"fieldname": "campaign_key",
			"fieldtype": "Data",
			"label": "Campaign Key",
			"reqd": 1,
			"unique": 1,
			"in_list_view": 1
		},
		{
			"fieldname": "title",
			"fieldtype": "Data",
			"label": "Title",
			"reqd": 1,
			"in_list_view": 1
		},
		{
			"fieldname": "description",
			"fieldtype": "Small Text",
			"label": "Description"
		},
		{
			"fieldname": "channel",
			"fieldtype": "Link",
			"label": "Channel",
			"options": "WhatsApp Core Channel",
			"reqd": 1
		},
		{
			"fieldname": "content_type",
			"fieldtype": "Select",
			"label": "Content Type",
			"options": "Template\nText",
			"default": "Template",
			"reqd": 1
		},
		{
			"fieldname": "template",
			"fieldtype": "Link",
			"label": "Assigned Template",
			"options": "WhatsApp Core Template",
			"depends_on": "eval:doc.content_type == 'Template'",
			"mandatory_depends_on": "eval:doc.content_type == 'Template'"
		},
		{
			"fieldname": "message_text",
			"fieldtype": "Long Text",
			"label": "Message Text",
			"depends_on": "eval:doc.content_type == 'Text'",
			"mandatory_depends_on": "eval:doc.content_type == 'Text'"
		},
		{
			"fieldname": "template_snapshot",
			"fieldtype": "JSON",
			"label": "Approved Template Snapshot",
			"read_only": 1,
			"hidden": 1
		},
		{
			"fieldname": "audience_source",
			"fieldtype": "JSON",
			"label": "Audience Source"
		},
		{
			"fieldname": "status",
			"fieldtype": "Select",
			"label": "Status",
			"options": "Draft\nPrepared\nScheduled\nRunning\nPaused\nCompleted\nCancelled",
			"default": "Draft",
			"reqd": 1,
			"in_list_view": 1
		},
		{
			"fieldname": "send_authorized",
			"fieldtype": "Check",
			"label": "Send Authorized",
			"default": "0",
			"read_only": 1
		},
		{
			"fieldname": "authorized_by",
			"fieldtype": "Link",
			"label": "Authorized By",
			"options": "User",
			"read_only": 1
		},
		{
			"fieldname": "authorized_at",
			"fieldtype": "Datetime",
			"label": "Authorized At",
			"read_only": 1
		},
		{
			"fieldname": "prepared_at",
			"fieldtype": "Datetime",
			"label": "Prepared At",
			"read_only": 1
		},
		{
			"fieldname": "scheduled_for",
			"fieldtype": "Datetime",
			"label": "Scheduled For"
		},
		{
			"fieldname": "started_at",
			"fieldtype": "Datetime",
			"label": "Started At",
			"read_only": 1
		},
		{
			"fieldname": "completed_at",
			"fieldtype": "Datetime",
			"label": "Completed At",
			"read_only": 1
		},
		{
			"fieldname": "recipient_count",
			"fieldtype": "Int",
			"label": "Recipients",
			"default": "0",
			"read_only": 1
		},
		{
			"fieldname": "queued_count",
			"fieldtype": "Int",
			"label": "Queued",
			"default": "0",
			"read_only": 1
		},
		{
			"fieldname": "sent_count",
			"fieldtype": "Int",
			"label": "Sent",
			"default": "0",
			"read_only": 1
		},
		{
			"fieldname": "delivered_count",
			"fieldtype": "Int",
			"label": "Delivered",
			"default": "0",
			"read_only": 1
		},
		{
			"fieldname": "read_count",
			"fieldtype": "Int",
			"label": "Read",
			"default": "0",
			"read_only": 1
		},
		{
			"fieldname": "failed_count",
			"fieldtype": "Int",
			"label": "Failed",
			"default": "0",
			"read_only": 1
		},
		{
			"fieldname": "skipped_count",
			"fieldtype": "Int",
			"label": "Skipped",
			"default": "0",
			"read_only": 1
		}
	],
	"permissions": [
		{
			"role": "System Manager",
			"read": 1,
			"write": 1,
			"create": 1,
			"delete": 1,
			"export": 1
		},
		{
			"role": "WhatsApp Manager",
			"read": 1,
			"write": 1,
			"create": 1,
			"delete": 1,
			"export": 1
		}
	],
	"sort_field": "modified",
	"sort_order": "DESC",
	"track_changes": 1
}
